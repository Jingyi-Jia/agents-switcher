Screen {
    background: $background;
    color: $foreground;
}

.app-header {
    height: 3;
    padding: 1 3;
    background: $panel;
}

Footer {
    background: $panel;
}

#provider-content {
    width: 80;
    max-width: 100%;
    padding: 2 3;
    align-horizontal: center;
}

ProviderScreen {
    align-horizontal: center;
}

#provider-title {
    height: auto;
    margin-bottom: 1;
    text-style: bold;
}

#provider-prompt {
    height: auto;
    margin-bottom: 2;
    color: $secondary;
}

#providers {
    height: 1fr;
    background: $background;
    scrollbar-size-vertical: 1;
}

#providers ListItem {
    height: auto;
    padding: 1 2;
    margin-bottom: 1;
    border: round $track;
    background: $surface;
}

#providers ListItem:first-child > Static:first-child {
    color: $claude-accent;
}

#providers ListItem > Static:first-child {
    color: $primary;
    text-style: bold;
}

#providers ListItem.-highlight, #providers:focus ListItem.-highlight {
    border: round $active-border;
    background: $accent-soft;
    text-style: none;
}

.menu-description {
    height: auto;
    margin-top: 1;
    color: $secondary;
}

#dashboard-body {
    height: 1fr;
}

#action-panel {
    width: 32;
    background: $panel;
    padding: 1 1 0 1;
    border-right: solid $track;
}

#overview {
    width: 1fr;
    height: 1fr;
    padding: 1 3;
    scrollbar-size-vertical: 1;
}

.section-heading {
    height: auto;
    text-style: bold;
    color: $primary;
}

.section-heading.claude {
    color: $claude-accent;
}

.section-caption {
    height: auto;
    color: $secondary;
    margin-bottom: 1;
}

#accounts-panel, #auto-active-panel {
    height: auto;
    padding: 1 2;
    background: $surface;
    border: round $track;
}

.provider-notice {
    height: auto;
    padding: 1 2;
    margin-top: 1;
    background: $panel;
    border-left: solid $track;
    color: $secondary;
}

#status-panel {
    height: auto;
    max-height: 25%;
    scrollbar-size-vertical: 1;
}

#codex-status {
    height: auto;
    padding: 0 2;
    background: $panel;
    color: $warning;
}

#menu-title {
    height: auto;
    padding: 0 1;
    margin-bottom: 1;
    color: $secondary;
}

#menu {
    background: $panel;
    height: 1fr;
    scrollbar-size-vertical: 1;
}

#menu:focus, #accounts:focus, #providers:focus {
    background-tint: $foreground 0%;
}

#menu ListItem {
    background: transparent;
    padding: 0 1;
    margin-bottom: 1;
    border-left: thick $panel;
}

#menu ListItem.-highlight, #menu:focus ListItem.-highlight {
    color: $foreground;
    background: $accent-soft;
    text-style: none;
    border-left: thick $primary;
}

MenuItem Static {
    color: $foreground;
}

MenuItem Static.menu-item-muted, .navigation-hint {
    color: $secondary;
}

.navigation-hint {
    height: auto;
    padding: 1;
}

.compact-hint {
    display: none;
    height: 1;
    color: $secondary;
}

#list-title {
    height: auto;
    margin-top: 1;
    padding: 0 3;
    text-style: bold;
}

.list-caption {
    height: auto;
    padding: 0 3;
    color: $secondary;
}

.empty-state {
    height: auto;
    padding: 1 2;
    margin: 1 2;
    border: round $track;
    background: $panel;
    color: $secondary;
}

#accounts {
    background: $background;
    padding: 1 2;
    scrollbar-size-vertical: 1;
}

#accounts ListItem {
    background: $surface;
    padding: 1 2;
    margin-bottom: 1;
    border: round $track;
}

#accounts ListItem.active-account {
    border: round $active-border;
}

#accounts ListItem.disabled-account {
    border: dashed $track;
}

#accounts ListItem.-highlight, #accounts:focus ListItem.-highlight {
    background: $accent-soft;
    border-left: thick $primary;
    text-style: none;
}

#accounts ListItem.flash {
    background: $panel;
}

#auto-overview {
    height: 2fr;
    padding: 1 2;
    scrollbar-size-vertical: 1;
}

#auto-top {
    height: auto;
    margin-top: 1;
    background: $panel;
    border: round $track;
    padding: 1 2;
}

#auto-title-row {
    height: auto;
    margin-bottom: 1;
}

#mode-badge {
    width: auto;
    height: 1;
    text-style: bold;
}

#mode-badge.dry {
    background: $surface;
    color: $warning;
}

#mode-badge.live {
    background: $primary;
    color: $background;
}

#auto-summary {
    width: 1fr;
    height: auto;
    color: $secondary;
    padding-left: 2;
}

#candidates {
    height: auto;
}

#event-log {
    height: 1fr;
    min-height: 3;
    background: $panel;
    border-top: solid $track;
    padding: 0 2;
    scrollbar-size-vertical: 1;
}

ConfirmModal, AddTokenModal, OutputModal {
    align: center middle;
    background: $background 75%;
}

.modal-box {
    width: 66;
    max-width: 94%;
    height: auto;
    max-height: 90%;
    background: $surface;
    border: round $track;
    padding: 1 2;
    scrollbar-size-vertical: 1;
}

.modal-box-wide {
    width: 90;
}

.modal-title {
    width: 1fr;
    height: auto;
    text-style: bold;
    color: $primary;
    margin-bottom: 1;
}

.modal-body {
    height: auto;
    color: $foreground;
    margin-bottom: 1;
}

.modal-buttons {
    height: auto;
    align-horizontal: right;
    margin-top: 1;
}

.modal-buttons Button {
    border: none;
    height: 1;
    min-width: 10;
    padding: 0 1;
    margin-left: 2;
    background: $panel;
    color: $foreground;
    text-style: none;
}

.modal-buttons Button:hover {
    background: $accent-soft;
}

.modal-buttons Button:focus {
    background: $primary;
    color: $background;
    text-style: bold;
}

.modal-hint {
    height: auto;
    margin-top: 1;
    color: $secondary;
}

.modal-output {
    height: auto;
    max-height: 20;
    background: $panel;
    padding: 1;
}

.form-error {
    height: auto;
    min-height: 1;
    color: $error;
}

AddTokenModal Input {
    margin-bottom: 1;
    background: $panel;
    border: tall $track;
}

AddTokenModal Input:focus {
    border: tall $primary;
}

Screen.-compact .app-header {
    padding: 1 2;
}

Screen.-compact #dashboard-body {
    layout: vertical;
}

Screen.-compact #action-panel {
    dock: bottom;
    width: 1fr;
    height: 9;
    padding: 0 1;
    border-right: none;
    border-top: solid $track;
}

Screen.-compact #overview {
    width: 1fr;
    padding: 1 2;
}

Screen.-compact #menu-title {
    margin: 0;
}

Screen.-compact #menu ListItem, Screen.-short #menu ListItem {
    margin-bottom: 0;
}

Screen.-compact #action-panel .navigation-hint {
    display: none;
}

Screen.-compact .compact-hint {
    display: block;
}

Screen.-compact #accounts-panel, Screen.-compact #auto-active-panel,
Screen.-compact #accounts ListItem {
    padding: 0 1;
}

Screen.-compact .provider-notice {
    padding: 1;
}

Screen.-compact #provider-content {
    padding: 1 2;
}

Screen.-compact #providers ListItem {
    padding: 1;
}

Screen.-compact #auto-title-row {
    layout: vertical;
}

Screen.-compact #auto-summary {
    width: 1fr;
    padding: 1 0 0 0;
}

Screen.-short .app-header {
    height: 1;
    padding: 0 2;
}

Screen.-short #overview, Screen.-short #auto-overview {
    padding: 0 2;
}

Screen.-short.-wide #overview {
    padding: 0 3;
}

Screen.-short #action-panel .navigation-hint {
    display: none;
}
